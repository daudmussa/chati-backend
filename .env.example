# Copy this file to .env and fill in the real values. Do NOT commit your real .env to source control.
# Example placeholder environment variables for the server
CLAUDE_API_KEY=sk-REPLACE_ME
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+12345678900
PORT=3000
BYPASS_CLAUDE=0
BUSINESS_CONTEXT=Describe your business here. This context will be sent to Claude with every customer message so the AI can answer business-specific questions.

# Baileys WhatsApp linked-device sessions (generate a private random secret of 32+ characters)
BAILEYS_SESSION_ENCRYPTION_KEY=replace_with_a_private_random_secret_at_least_32_characters
BAILEYS_MAX_CONNECTIONS_PER_USER=5

# Bunny.net Storage Configuration
BUNNY_STORAGE_ZONE=your_storage_zone_name
BUNNY_API_KEY=your_bunny_api_key_here
BUNNY_CDN_URL=https://your-storage-zone.b-cdn.net

# Notes:
# - Keep your real credentials secret. Rotate any keys that were exposed.
# - For Twilio, use a number that supports SMS for destination countries.
# - If you need to expose a local server for Twilio webhooks, use ngrok and configure webhook URLs in Twilio Console.
# - Get Bunny credentials from https://dash.bunny.net/
# - Keep BAILEYS_SESSION_ENCRYPTION_KEY stable and private; changing it makes saved WhatsApp sessions unreadable.
