# Copy this file to .env and fill in the real values. Do NOT commit your real .env to source control.
# Standalone WhatsApp Bulk application
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_bulk
JWT_SECRET=replace_with_a_private_random_secret_at_least_32_characters
ENCRYPTION_KEY=replace_with_a_private_random_secret_at_least_32_characters

# Baileys WhatsApp linked-device sessions (generate a private random secret of 32+ characters)
BAILEYS_SESSION_ENCRYPTION_KEY=replace_with_a_private_random_secret_at_least_32_characters
BAILEYS_MAX_CONNECTIONS_PER_USER=5
INITIAL_ADMIN_EMAIL=admin@example.com

# Notes:
# - Keep JWT_SECRET, ENCRYPTION_KEY, and BAILEYS_SESSION_ENCRYPTION_KEY private and stable.
# - Changing BAILEYS_SESSION_ENCRYPTION_KEY makes previously saved linked-device sessions unreadable.
